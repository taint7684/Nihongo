{
  "name": "nihongo-compass",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "node scripts/coverage.mjs && vite build --config vite.config.js",
    "test": "vitest run src",
    "test:ui": "node scripts/learning-flow-ui.mjs",
    "start": "node scripts/start.mjs",
    "coverage": "node scripts/coverage.mjs",
    "test:access": "node scripts/open-access-ui.mjs",
