    "test:voice": "node scripts/voice-storage-ui.mjs",
    "test:foundation": "node scripts/n5-foundation-ui.mjs",
    "test:ai-boundary": "node scripts/ai-boundary-ui.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
